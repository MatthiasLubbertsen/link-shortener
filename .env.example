# Copy to .env and fill in. SESSION_SECRET must be at least 32 characters.
SESSION_SECRET=
PUBLIC_URL=https://go.example.com

# OIDC provider. The defaults below are Hack Club Auth.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUTHORIZE_URL=https://auth.hackclub.com/oauth/authorize
OIDC_TOKEN_URL=https://auth.hackclub.com/oauth/token
OIDC_USERINFO_URL=https://auth.hackclub.com/oauth/userinfo
OIDC_SCOPE=openid profile email slack_id verification_status
OIDC_REQUIRE_VERIFIED=true

# Only these emails can sign in (comma-separated). Leave empty to allow anyone.
OIDC_ALLOWED_EMAILS=

# Tinyauth example (replace tinyauth.example.com with your instance):
# OIDC_AUTHORIZE_URL=https://tinyauth.example.com/authorize
# OIDC_TOKEN_URL=https://tinyauth.example.com/api/oidc/token
# OIDC_USERINFO_URL=https://tinyauth.example.com/api/oidc/userinfo
# OIDC_SCOPE=openid profile email
# OIDC_REQUIRE_VERIFIED=false

# Liwan analytics (optional). The dashboard's public URL, and the id of the
# entity you create in Liwan. Leave LIWAN_ENTITY_ID empty to disable.
LIWAN_BASE_URL=https://stats.example.com
LIWAN_ENTITY_ID=

# Only for docker-compose.traefik.yml
SHORTENER_DOMAIN=go.example.com
PORTFOLIO_DOMAIN=example.com
# PORTFOLIO_ASSET_DIRS=assets|static|_next|_astro
# TRAEFIK_NETWORK=proxy
